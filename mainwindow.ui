  <property name="styleSheet">
   <string notr="true">QMainWindow {
	background-color: #16202B; }
/* Warna latar belakang sidebar */
QWidget#widget {
    background-color: #2c3e50; 
	border-radius: 10px;
}

/* Gaya tombol navigasi sidebar */
QPushButton {
    background-color: transparent;
    color: #C9C9C9;
    border: none;
    text-align: left;
    padding: 8px 16px;
    font-size: 12px;
	font-weight: 600;
    border-radius: 6px;
    margin: 2px 8px;
}

/* Efek saat kursor menyentuh tombol (Hover) */
QPushButton:hover {
    background-color: #34495e;
}

/* Efek saat tombol diklik */
QPushButton:pressed {
    background-color: #1abc9c;
}

/* --- KARTU KAMAR (RoomCard) --- */
QFrame#cardKamar {
    background-color: #1E2B38;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
    margin: 5px;
}

QFrame#cardKamar:hover {
    border-color: #3498db;
    background-color: #fafbfc;
}

/* --- TEKS &amp; BADGE DI DALAM KARTU --- */
QLabel[objectName=&quot;lblRoomName&quot;] {
    color: #2c3e50;
    font-size: 18px;
    font-weight: 700;
}

QLabel[objectName=&quot;lblRoomPrice&quot;] {
    color: #7f8c8d;
    font-size: 13px;
}

QLabel[objectName=&quot;lblStatusAvail&quot;] {
    color: #27ae60;
    background-color: #e8f5e9;
    padding: 4px 8px;
    border-radius: 15px;
    font-size: 11px;
    font-weight: 700;
}

QLabel[objectName=&quot;lblStatusOcc&quot;] {
    color: #c0392b;
    background-color: #ffebee;
    padding: 4px 8px;
    border-radius: 15px;
    font-size: 11px;
    font-weight: 700;
}

/* --- TOMBOL DETAIL PADA KARTU --- */
QPushButton#btnDetail {
    background-color: #3498db;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px;
    font-weight: 600;
}

QPushButton#btnDetail:hover {
    background-color: #2980b9;
}

QPushButton#btnDetail:pressed {
    background-color: #1a5276;
}

QScrollArea {
    background-color: transparent;
}

QScrollArea &gt; QWidget &gt; QWidget {
    background-color: transparent;
}</string>
